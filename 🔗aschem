    <div class="qtext">${esc(q.q)}</div>
    ${figSrc(q.img) ? `<img class="q-figure" src="${figSrc(q.img)}" alt="${esc(q.alt)}">` : ''}
    <div class="opts">${q.opts.map((o, i) => `<button class="opt" data-act="pick" data-i="${i}"><span class="k">${'ABCD'[i]}</span><span>${esc(o)}</span></button>`).join('')}</div>
    <div class="fb" id="fb" hidden></div></div>`;
