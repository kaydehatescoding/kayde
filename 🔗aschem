  const qs = shuffle([...core, ...com]).slice(0, 10).map(x => ({ ...x, opts: shuffle(x.opts) }));
  G = { kind: 'mcq', id, qs, i: 0, correct: 0, answered: 0, streak: 0, bestStreak: 0, score: 0, t0: 0, locked: false, started: Date.now() };
