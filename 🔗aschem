<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Bondly: learn A-Level biology and chemistry</title>
<meta name="description" content="Bondly: quick quiz lessons for Cambridge A-Level style chemistry and biology, with streaks and a leaderboard.">
<meta name="theme-color" content="#ffffff">
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns=%27http://www.w3.org/2000/svg%27 viewBox=%270 0 100 100%27%3E%3Cpolygon points=%2750,6 88,28 88,72 50,94 12,72 12,28%27 fill=%27none%27 stroke=%27%232563eb%27 stroke-width=%2710%27 stroke-linejoin=%27round%27/%3E%3C/svg%3E">
<style>
@import url('https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,600;12..96,800&family=DM+Sans:wght@400;500;700&display=swap');

:root{
  --ink:#15213b; --ink2:#4d5a78; --paper:#f1f5f9; --card:#fff; --line:#d5dde8;
  --chem:#5b3fd6; --chem-d:#3d27a6; --chem-l:#ece8fc;
  --bio:#16945f; --bio-d:#0d6a43; --bio-l:#e0f4ea;

  --ok:#1fa35b; --ok-d:#137a41; --ok-l:#dcf4e6;
  --bad:#e0452b; --bad-d:#ae2b15; --bad-l:#fde4de;
  --gold:#f5b82a; --gold-d:#c28a08;
  --accent:var(--chem); --accent-d:var(--chem-d); --accent-l:var(--chem-l);
}
body.bio{ --accent:var(--bio); --accent-d:var(--bio-d); --accent-l:var(--bio-l); }

*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
html,body{margin:0}
body{
  font-family:'DM Sans',system-ui,-apple-system,'Segoe UI',Roboto,sans-serif;
  color:var(--ink);font-size:16px;line-height:1.45;min-height:100vh;min-height:100dvh;
  background-color:var(--paper);
  background-image:linear-gradient(rgba(21,33,59,.05) 1px,transparent 1px),linear-gradient(90deg,rgba(21,33,59,.05) 1px,transparent 1px);
  background-size:24px 24px;
}
h1,h2,h3,.disp{font-family:'Bricolage Grotesque','DM Sans',system-ui,sans-serif;letter-spacing:-.01em;margin:0;line-height:1.12}
p{margin:0}
button{font:inherit;color:inherit;cursor:pointer}
button:focus-visible,input:focus-visible,select:focus-visible,textarea:focus-visible{outline:3px solid var(--gold);outline-offset:2px}
#app{max-width:540px;margin:0 auto;min-height:100vh;min-height:100dvh;position:relative}
.main{padding:14px 16px 110px}

/* buttons */
.btn{display:block;width:100%;border:0;border-radius:15px;padding:14px 18px;font-weight:800;font-size:16px;background:var(--accent);color:#fff;box-shadow:0 5px 0 var(--accent-d);text-align:center;transition:transform .06s,box-shadow .06s}
.btn:active{transform:translateY(4px);box-shadow:0 1px 0 var(--accent-d)}
.btn.ghost{background:#fff;color:var(--ink);border:2px solid var(--line);box-shadow:0 4px 0 var(--line)}
.btn.ghost:active{box-shadow:0 0 0 var(--line)}
.btn.ok{background:var(--ok);box-shadow:0 5px 0 var(--ok-d)}
.btn.bad{background:var(--bad);box-shadow:0 5px 0 var(--bad-d)}
.btn.small{display:inline-block;width:auto;padding:9px 14px;font-size:14px;border-radius:12px;box-shadow:0 3px 0 var(--accent-d)}
.btn.small.ghost{box-shadow:0 3px 0 var(--line)}
.btn[disabled]{opacity:.5;pointer-events:none}
.row{display:flex;gap:10px}
.row>*{flex:1}

/* login */
.login{padding:36px 22px 40px}
.login .ring{width:92px;height:92px;display:block;margin:0 0 14px}
.login h1{font-size:44px;font-weight:800}
.login .tag{font-size:19px;color:var(--ink2);margin:8px 0 26px;max-width:22em}
label.f{display:block;font-weight:700;font-size:14px;margin:14px 0 6px}
label.f small{font-weight:400;color:var(--ink2)}
input[type=text],input[type=email],textarea,select{width:100%;font:inherit;color:var(--ink);background:#fff;border:2px solid var(--line);border-radius:13px;padding:12px 14px}
input:focus,textarea:focus,select:focus{border-color:var(--accent)}
textarea{resize:vertical;min-height:84px}
.err{color:var(--bad-d);font-weight:700;font-size:14px;min-height:20px;margin:10px 0}
.fine{font-size:13px;color:var(--ink2);margin-top:14px}

/* top area */
.top{display:flex;align-items:center;gap:10px;margin-bottom:12px}
.seg{flex:1;display:flex;background:#fff;border:2px solid var(--line);border-radius:15px;padding:3px;gap:3px}
.seg button{flex:1;border:0;background:none;border-radius:11px;padding:9px 6px;font-weight:700;color:var(--ink2)}
.seg button.on{background:var(--accent);color:#fff}
.chip.total{background:var(--gold);color:#4a3300;font-weight:800;border-radius:999px;padding:8px 13px;white-space:nowrap}
.semtabs{display:flex;gap:8px;margin-bottom:12px}
.semtabs button{flex:1;border:2px solid var(--line);background:#fff;border-radius:12px;padding:8px 4px;font-weight:700;font-size:14px;color:var(--ink2)}
.semtabs button.on{border-color:var(--accent);color:var(--accent-d);background:var(--accent-l)}
.sembanner{background:var(--accent);color:#fff;border-radius:18px;padding:16px 18px;box-shadow:0 5px 0 var(--accent-d)}
.sembanner h2{font-size:24px}
.sembanner .n{font-size:14px;opacity:.85;margin-bottom:2px}
.sembanner p.b{font-size:15px;margin-top:6px;opacity:.95}

/* path */
.path{padding:6px 0 4px}
.step{display:flex;flex-direction:column;align-items:center;margin:20px 0 4px;transform:translateX(var(--dx,0))}
.hex{position:relative;width:84px;height:102px;border:0;background:none;padding:0}
.hex .hb,.hex .hf{position:absolute;left:0;width:84px;height:96px;clip-path:polygon(50% 0,100% 25%,100% 75%,50% 100%,0 75%,0 25%)}
.hex .hb{top:6px;background:var(--accent-d)}
.hex .hf{top:0;background:var(--accent);display:grid;place-items:center;font-size:32px;transition:transform .07s}
.hex:active .hf{transform:translateY(5px)}
.hex.locked .hb{background:#b3bfce}
.hex.locked .hf{background:#d5dce7;font-size:26px}
.hex.done .hb{background:var(--gold-d)}
.hex.done .hf{background:var(--gold)}
.hex.current .hf{animation:pulse 1.9s ease-in-out infinite}
@keyframes pulse{0%,100%{filter:brightness(1)}50%{filter:brightness(1.18)}}
.sl{font-weight:700;font-size:14px;margin-top:6px;text-align:center;max-width:150px}
.stars{color:var(--gold-d);letter-spacing:2px;font-size:15px}
.mmhead{margin:34px 0 4px;background:var(--ink);color:#fff;border-radius:18px;padding:16px 18px}
.mmhead h3{font-size:21px;margin-bottom:6px}
.mmhead p{font-size:14px;opacity:.88}

/* tabs */
.tabs{position:fixed;left:0;right:0;bottom:0;z-index:20;display:flex;justify-content:center;background:#fff;border-top:2px solid var(--line);padding-bottom:env(safe-area-inset-bottom)}
.tabs .in{display:flex;width:100%;max-width:540px}
.tabs button{flex:1;border:0;background:none;padding:9px 2px 8px;color:var(--ink2);font-size:12px;font-weight:700;display:flex;flex-direction:column;align-items:center;gap:2px}
.tabs button span{font-size:22px;line-height:1.1}
.tabs button.on{color:var(--accent-d)}

/* sheet */
.overlay{position:fixed;inset:0;background:rgba(21,33,59,.5);z-index:40;display:flex;align-items:flex-end;justify-content:center}
.sheet{width:100%;max-width:540px;background:#fff;border-radius:24px 24px 0 0;padding:22px 20px calc(22px + env(safe-area-inset-bottom));animation:up .22s ease-out}
@keyframes up{from{transform:translateY(40px);opacity:0}to{transform:none;opacity:1}}
.sheet .ic{font-size:40px}
.sheet h3{font-size:24px;margin:4px 0 2px}
.sheet .sub{color:var(--ink2);font-size:14px;margin-bottom:12px}
.stats{display:flex;gap:10px;margin:12px 0 18px}
.stat{flex:1;border:2px solid var(--line);border-radius:14px;padding:9px 10px}
.stat b{display:block;font-family:'Bricolage Grotesque',sans-serif;font-size:22px}
.stat span{font-size:12px;color:var(--ink2)}

/* lesson */
.play{display:flex;flex-direction:column;min-height:100vh;min-height:100dvh;padding:14px 16px 190px}
.ptop{display:flex;align-items:center;gap:12px}
.x{border:0;background:none;font-size:22px;color:var(--ink2);padding:4px 6px}
.spectrum{flex:1;height:14px;border-radius:99px;overflow:hidden;position:relative;background:linear-gradient(90deg,#e0452b,#f0892a,#f5cf3a,#3fb950,#2f8ae0,#6a45d8)}
.spectrum .cover{position:absolute;right:0;top:0;bottom:0;background:#dfe6ef;transition:width .35s ease}
.live{display:flex;gap:10px;font-weight:800;font-size:14px;white-space:nowrap}
.tbar{height:6px;background:#dfe6ef;border-radius:99px;overflow:hidden;margin:16px 0 22px}
.tbar i{display:block;height:100%;width:100%;background:var(--accent);animation:drain linear forwards}
@keyframes drain{from{width:100%}to{width:0}}
.qtag{font-size:13px;font-weight:700;color:var(--accent-d);margin-bottom:6px}
.qtext{font-size:23px;font-weight:800;font-family:'Bricolage Grotesque','DM Sans',sans-serif;line-height:1.22;margin-bottom:22px}
.q-figure{display:block;max-width:100%;max-height:260px;object-fit:contain;margin:0 auto 18px;border-radius:12px;background:#fff;border:2px solid var(--line)}
.opts{display:flex;flex-direction:column;gap:11px}
.opt{display:flex;gap:12px;align-items:center;width:100%;text-align:left;background:#fff;border:2px solid var(--line);border-bottom-width:5px;border-radius:16px;padding:13px 14px;font-weight:500;color:var(--ink)}
.opt .k{flex:none;width:30px;height:30px;border-radius:9px;border:2px solid var(--line);display:grid;place-items:center;font-weight:800;font-size:14px;color:var(--ink2)}
.opt:hover{border-color:var(--accent)}
.opt.ok{background:var(--ok-l);border-color:var(--ok);color:var(--ok-d)}
.opt.ok .k{border-color:var(--ok);background:var(--ok);color:#fff}
.opt.bad{background:var(--bad-l);border-color:var(--bad);color:var(--bad-d)}
.opt.bad .k{border-color:var(--bad);background:var(--bad);color:#fff}
.opt.dim{opacity:.5}
.fb{position:fixed;left:50%;transform:translateX(-50%);bottom:0;width:100%;max-width:540px;z-index:30;padding:16px 18px calc(18px + env(safe-area-inset-bottom));animation:up .2s ease-out}
.fb.ok{background:var(--ok-l);border-top:3px solid var(--ok)}
.fb.bad{background:var(--bad-l);border-top:3px solid var(--bad)}
.fb h3{font-size:21px;margin-bottom:4px}
.fb.ok h3{color:var(--ok-d)} .fb.bad h3{color:var(--bad-d)}
.fb .calc{font-weight:700;font-size:14px;margin-bottom:4px}
.fb .exp{font-size:14px;color:var(--ink2);margin-bottom:12px}

/* results */
.result{padding:40px 22px;text-align:center}
.result .st{font-size:40px;color:var(--gold-d);letter-spacing:6px}
.result h2{font-size:32px;margin:8px 0 4px}
.result .big{font-family:'Bricolage Grotesque',sans-serif;font-size:72px;font-weight:800;color:var(--accent);line-height:1;margin:14px 0 2px}
.result .lab{color:var(--ink2);font-size:14px}
.result .stats{margin:22px 0}
.badge{display:inline-block;background:var(--gold);color:#4a3300;font-weight:800;font-size:13px;border-radius:99px;padding:4px 12px;margin-top:6px}

/* boards, lists */
h2.pg{font-size:28px;margin:4px 0 4px}
.sub{color:var(--ink2);font-size:14px}
.pills{display:flex;gap:8px;margin:14px 0}
.pills button{border:2px solid var(--line);background:#fff;border-radius:99px;padding:7px 14px;font-weight:700;font-size:14px;color:var(--ink2)}
.pills button.on{background:var(--ink);border-color:var(--ink);color:#fff}
.lb{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:8px}
.lb li{display:flex;align-items:center;gap:12px;background:#fff;border:2px solid var(--line);border-radius:14px;padding:10px 14px}
.lb li.me{border-color:var(--accent);background:var(--accent-l)}
.lb .rk{width:30px;font-family:'Bricolage Grotesque',sans-serif;font-weight:800;font-size:18px;text-align:center}
.lb .nm{flex:1;font-weight:700;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.lb .sc{font-family:'Bricolage Grotesque',sans-serif;font-weight:800;font-size:18px}
.empty{background:#fff;border:2px dashed var(--line);border-radius:16px;padding:22px;text-align:center;color:var(--ink2)}
.card{background:#fff;border:2px solid var(--line);border-radius:16px;padding:14px 16px;margin-bottom:12px}
.card h3{font-size:18px;margin-bottom:6px}
.optrow{display:flex;align-items:center;gap:10px;margin-bottom:8px}
.optrow input[type=radio]{width:22px;height:22px;accent-color:var(--ok);flex:none}
.q-item .qq{font-weight:700;margin:4px 0}
.q-item ul{margin:4px 0 0;padding-left:20px;font-size:14px;color:var(--ink2)}
.q-item li.c{color:var(--ok-d);font-weight:700}
.q-item .meta{font-size:12px;color:var(--ink2)}
pre.code{background:var(--ink);color:#e8eefc;border-radius:12px;padding:12px;font-size:12px;overflow:auto;white-space:pre-wrap}
details{margin:10px 0}
summary{cursor:pointer;font-weight:700;font-size:14px}
.errlist{font-size:13px;color:var(--bad-d);margin:8px 0;padding-left:18px}

/* profile */
.who{display:flex;align-items:center;gap:14px;margin:6px 0 16px}
.av{width:64px;height:64px;border-radius:50%;background:var(--accent);color:#fff;display:grid;place-items:center;font-family:'Bricolage Grotesque',sans-serif;font-weight:800;font-size:28px;box-shadow:0 4px 0 var(--accent-d)}
.grid2{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:16px}
.av{overflow:hidden;flex:none}
.av img{width:100%;height:100%;object-fit:cover;display:block}
.av.sm{width:34px;height:34px;font-size:15px;box-shadow:none}
.avbtn{position:relative;border:0;background:none;padding:0;border-radius:50%;cursor:pointer;flex:none}
.avbtn .av{width:76px;height:76px}
.avbtn .cam{position:absolute;right:-4px;bottom:-4px;width:28px;height:28px;border-radius:50%;background:#fff;border:2px solid var(--line);display:grid;place-items:center;font-size:14px}
.avrow{display:flex;gap:8px;margin:-6px 0 16px}
.avrow .btn{padding:8px 14px;font-size:14px;width:auto}

/* mind map */
.mm{display:flex;flex-direction:column;min-height:100vh;min-height:100dvh}
.mmtop{padding:14px 16px 6px}
.mmtitle{margin:14px 0 4px;font-size:24px}
.mmhelp{font-size:13px;color:var(--ink2)}
.mmstrip{min-height:28px;margin:8px 0 0;font-weight:700;font-size:14px}
.mmstrip.ok{color:var(--ok-d)} .mmstrip.bad{color:var(--bad-d)}
.mmrows{flex:1;padding:6px 16px 16px;display:flex;flex-direction:column;gap:10px}
.mmrow{display:grid;grid-template-columns:1fr 24px 1fr;gap:6px;align-items:center;background:#fff;border:2px solid var(--line);border-radius:16px;padding:10px 10px 8px}
.mmrow.ok{border-color:var(--ok);background:#f6fcf8}
.mmrow.flash{animation:flash .5s}
@keyframes flash{0%,100%{border-color:var(--line)}30%{border-color:var(--bad);background:var(--bad-l)}}
.arr{color:var(--ink2);font-size:14px;text-align:center}
.mn{min-height:58px;border-radius:12px;border:2px solid var(--line);padding:6px 8px;display:flex;flex-direction:column;justify-content:center;background:#fafcfe;min-width:0}
.mn b{font-size:13px;line-height:1.2;overflow-wrap:anywhere}
.mn code{font-family:inherit;font-size:11px;color:var(--ink2);margin-top:2px;overflow-wrap:anywhere}
.mn.hub{border-color:var(--gold-d);background:#fff8e3}
.mn.filled{border-color:var(--ok);background:var(--ok-l)}
.mn.blank{border-style:dashed;border-color:var(--ink2);background:#fff;align-items:center;font-size:24px;font-weight:800;color:var(--ink2);line-height:1}
.mn.blank small{font-size:11px;font-weight:500;margin-top:2px}
.mn.blank.sel{border-color:var(--accent);background:var(--accent-l);color:var(--accent-d);border-style:solid}
.mr{grid-column:1/-1;justify-self:center;margin-top:2px;max-width:100%}
.pill{display:inline-block;max-width:100%;background:var(--accent-l);color:var(--accent-d);border-radius:99px;padding:5px 12px;font-size:13px;font-weight:700;border:2px solid transparent;text-align:center;overflow-wrap:anywhere}
.pill.filled{background:var(--ok-l);color:var(--ok-d)}
.pill.blank{background:#fff;border:2px dashed var(--ink2);color:var(--ink2)}
.pill.blank.sel{border:2px solid var(--accent);background:var(--accent-l);color:var(--accent-d)}
.chipbar{position:sticky;bottom:0;background:#fff;border-top:3px solid var(--line);padding:12px 14px calc(14px + env(safe-area-inset-bottom));max-height:42vh;overflow:auto}
.chipbar .t{font-size:12px;color:var(--ink2);margin-bottom:8px}
.chips{display:flex;flex-wrap:wrap;gap:8px}
.chip{border:2px solid var(--line);border-bottom-width:4px;background:#fff;border-radius:12px;padding:7px 11px;font-weight:700;font-size:13px;text-align:left;color:var(--ink)}
.chip.reagent{border-radius:99px;background:var(--accent-l);border-color:var(--accent-l);border-bottom-color:var(--accent);color:var(--accent-d)}
.chip.shake{animation:shake .4s;border-color:var(--bad)}
@keyframes shake{0%,100%{transform:none}20%{transform:translateX(-6px)}40%{transform:translateX(6px)}60%{transform:translateX(-4px)}80%{transform:translateX(4px)}}

/* toasts / confirm */
#toasts{position:fixed;top:14px;left:0;right:0;z-index:100;display:flex;flex-direction:column;align-items:center;gap:8px;pointer-events:none}
.toast{background:var(--ink);color:#fff;padding:10px 16px;border-radius:12px;font-weight:700;font-size:14px;max-width:90vw;box-shadow:0 6px 18px rgba(0,0,0,.2)}
.toast.bad{background:var(--bad-d)} .toast.ok{background:var(--ok-d)}
.confirm{position:fixed;inset:0;background:rgba(21,33,59,.55);z-index:60;display:grid;place-items:center;padding:20px}
.confirm .box{background:#fff;border-radius:20px;padding:22px;max-width:380px;width:100%}
.confirm h3{font-size:22px;margin-bottom:6px}
.confirm p{color:var(--ink2);margin-bottom:16px}
.loading{display:grid;place-items:center;min-height:60vh;color:var(--ink2);font-weight:700}

@media (prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}
</style>
</head>
