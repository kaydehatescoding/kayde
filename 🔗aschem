    try { const d = await sb('/auth/v1/token?grant_type=refresh_token', { method: 'POST', noAuth: true, body: { refresh_token: this.s.refresh_token } }); this.save(this.pack(d)); return true; }
    catch (e) { if (e.status >= 400 && e.status < 500) this.save(null); throw e; }
  },
  async signOut() { try { await sb('/auth/v1/logout', { method: 'POST' }); } catch (e) {} this.save(null); }
};

const DB = {
  mode: 'memory', mem: new Map(),
  init() {
    if (ONLINE) { this.mode = 'online'; Auth.load(); return; }
    if (window.storage && typeof window.storage.get === 'function') { this.mode = 'cloud'; return; }
    try { localStorage.setItem('__bondly', '1'); localStorage.removeItem('__bondly'); this.mode = 'local'; }
    catch (e) { this.mode = 'memory'; }
  },
  lk(key, shared) { return 'bondly:' + (shared ? 's:' : 'p:') + key; },
  ok(key, shared) { return shared ? `scope=eq.s&key=eq.${enc(key)}` : `scope=eq.p&key=eq.${enc(key)}&owner=eq.${Auth.s.user.id}`; },
  async get(key, shared = false) {
    if (this.mode === 'online') {
      if (!(await Auth.fresh())) throw new Error('Not signed in');
      const rows = await sb(`/rest/v1/kv?${this.ok(key, shared)}&select=value&limit=1`);
      return rows && rows[0] ? rows[0].value : null;
    }
    try {
      if (this.mode === 'cloud') { const r = await window.storage.get(key, shared); return r && r.value != null ? JSON.parse(r.value) : null; }
      const raw = this.mode === 'local' ? localStorage.getItem(this.lk(key, shared)) : this.mem.get(this.lk(key, shared));
      return raw ? JSON.parse(raw) : null;
    } catch (e) { return null; }
  },
  async set(key, val, shared = false) {
    if (this.mode === 'online') {
      try {
        if (!(await Auth.fresh())) return false;
        await sb('/rest/v1/kv?on_conflict=owner,scope,key', { method: 'POST', headers: { Prefer: 'resolution=merge-duplicates,return=minimal' },
          body: { owner: Auth.s.user.id, scope: shared ? 's' : 'p', key, value: val, updated_at: new Date().toISOString() } });
        return true;
      } catch (e) { return false; }
    }
    try {
      const raw = JSON.stringify(val);
      if (this.mode === 'cloud') { const r = await window.storage.set(key, raw, shared); return !!r; }
      if (this.mode === 'local') localStorage.setItem(this.lk(key, shared), raw); else this.mem.set(this.lk(key, shared), raw);
      return true;
    } catch (e) { return false; }
  },
  async del(key, shared = false) {
    if (this.mode === 'online') {
      try { if (!(await Auth.fresh())) return false; await sb(`/rest/v1/kv?${this.ok(key, shared)}`, { method: 'DELETE' }); return true; } catch (e) { return false; }
    }
    try {
      if (this.mode === 'cloud') { await window.storage.delete(key, shared); return true; }
      if (this.mode === 'local') localStorage.removeItem(this.lk(key, shared)); else this.mem.delete(this.lk(key, shared));
      return true;
    } catch (e) { return false; }
  },
  async list(prefix, shared = false) {
    if (this.mode === 'online') {
      if (!(await Auth.fresh())) return [];
      const rows = await sb(`/rest/v1/kv?scope=eq.${shared ? 's' : 'p'}&key=like.${enc(prefix)}*&select=key&limit=1000`);
      return (rows || []).map(r => r.key);
    }
    try {
      if (this.mode === 'cloud') { const r = await window.storage.list(prefix, shared); return (r && r.keys) || []; }
      const p = this.lk(prefix, shared), base = this.lk('', shared);
      const all = this.mode === 'local' ? Object.keys(localStorage) : [...this.mem.keys()];
      return all.filter(k => k.startsWith(p)).map(k => k.slice(base.length));
    } catch (e) { return []; }
  },
  async listValues(prefix, shared = false, o = {}) {
    const limit = o.limit || 300;
    if (this.mode === 'online') {
      if (!(await Auth.fresh())) return [];
      const rows = await sb(`/rest/v1/kv?scope=eq.${shared ? 's' : 'p'}&key=like.${enc(prefix)}*&select=value&limit=${limit}${o.order ? '&order=' + o.order : ''}`);
      return (rows || []).map(r => r.value);
    }
    const keys = (await this.list(prefix, shared)).slice(0, limit);
    return (await Promise.all(keys.map(k => this.get(k, shared)))).filter(v => v != null);
  }
};

async function hashId(str) {
  try {
    const buf = await crypto.subtle.digest('SHA-256', new TextEncoder().encode('bondly:' + str));
    return [...new Uint8Array(buf)].slice(0, 8).map(b => b.toString(16).padStart(2, '0')).join('');
  } catch (e) { let h = 5381; for (const c of str) h = ((h << 5) + h + c.charCodeAt(0)) >>> 0; return 'x' + h.toString(16); }
}
