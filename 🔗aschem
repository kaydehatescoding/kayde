function renderPlay() {
  const q = G.qs[G.i], pct = Math.round(G.answered / G.qs.length * 100);
  $('#app').innerHTML = `<div class="play">
    <div class="ptop"><button class="x" data-act="quit" aria-label="Leave lesson">✕</button><div class="spectrum" role="progressbar" aria-valuenow="${pct}"><div class="cover" id="cover" style="width:${100 - pct}%"></div></div>${liveHTML()}</div>
