function calcPoints(t, limit, streak, correct, answered) {
  const speed = Math.max(1, Math.round(10 * (1 - t / limit)));
  const acc = answered ? correct / answered : 0;
  return { speed, streak, acc, pts: Math.max(1, Math.round(speed * streak * acc)) };
}

