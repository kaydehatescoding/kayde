function friendly(e) {
  const m = String((e && e.message) || '').toLowerCase();
  if (e instanceof TypeError || /failed to fetch|network|load failed/.test(m)) return 'Could not reach the server. Check your connection.';
  if (/expired|invalid|otp|token/.test(m)) return 'That code is wrong or has expired. Request a new one.';
  return 'Sign-in failed: ' + ((e && e.message) || 'unknown error');
}

