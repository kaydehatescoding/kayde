function viaImg(file) { return new Promise((res, rej) => { const u = URL.createObjectURL(file), im = new Image(); im.onload = () => { URL.revokeObjectURL(u); res(im); }; im.onerror = () => { URL.revokeObjectURL(u); rej(new Error('bad image')); }; im.src = u; }); }
function loadBitmap(file) { return window.createImageBitmap ? createImageBitmap(file, { imageOrientation: 'from-image' }).catch(() => viaImg(file)) : viaImg(file); }
function squareJpeg(src, size, q) {
  const w = src.width, h = src.height, m = Math.min(w, h), c = document.createElement('canvas'); c.width = c.height = size;
  const x = c.getContext('2d'); x.fillStyle = '#fff'; x.fillRect(0, 0, size, size);
  x.drawImage(src, (w - m) / 2, (h - m) / 2, m, m, 0, 0, size, size);
  return c.toDataURL('image/jpeg', q);
}
async function setAvatar(file) {
