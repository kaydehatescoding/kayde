function buildMM(id) {
  const L = MM_LEVELS.find(l => l.id === id);
  const eids = L.boss ? shuffle(Object.keys(ME)).slice(0, 10) : L.edges;
  const rows = eids.map(eid => {
    const [A, B, R] = ME[eid];
    const anchor = (L.center && B === L.center && A !== L.center) ? 'B' : 'A';
    return { eid, A, B, R, anchor, nodeKey: anchor === 'A' ? B : A, blank: Math.random() < 0.5 ? 'reagent' : 'node', done: false };
  });
  if (rows.every(r => r.blank === rows[0].blank)) rows[0].blank = rows[0].blank === 'node' ? 'reagent' : 'node';
  const ans = r => r.blank === 'reagent' ? r.R : MN[r.nodeKey][0];
  const chips = rows.map((r, i) => ({ id: 'c' + i, type: r.blank, text: ans(r), used: false }));
  const usedR = new Set(rows.map(r => r.R)), usedN = new Set(rows.flatMap(r => [r.A, r.B]));
  const rPool = shuffle([...new Set(Object.values(ME).map(e => e[2]))].filter(t => !usedR.has(t)));
  const nPool = shuffle(Object.keys(MN).filter(k => !usedN.has(k))).map(k => MN[k][0]);
  if (rows.some(r => r.blank === 'reagent')) rPool.slice(0, 2).forEach((t, i) => chips.push({ id: 'dr' + i, type: 'reagent', text: t, used: false }));
  if (rows.some(r => r.blank === 'node')) nPool.slice(0, 2).forEach((t, i) => chips.push({ id: 'dn' + i, type: 'node', text: t, used: false }));
  return { kind: 'mm', id, center: L.center, rows, chips: shuffle(chips), sel: 0, correct: 0, answered: 0, streak: 0, bestStreak: 0, score: 0, t0: performance.now(), started: Date.now(), msg: null, shake: null, flash: null, ans };
}
function startMM(id) { G = buildMM(id); S.sheet = null; S.screen = 'mm'; render(); }
function mmNode(key, o) {
  const [name, f] = MN[key];
  if (o.blank && !o.done) return `<button class="mn blank ${o.sel ? 'sel' : ''}" data-act="mmsel" data-row="${o.idx}" aria-label="Missing species">?<small>product</small></button>`;
  return `<div class="mn ${o.done ? 'filled' : ''} ${key === G.center ? 'hub' : ''}"><b>${key === G.center ? '★ ' : ''}${esc(name)}</b><code>${esc(f)}</code></div>`;
}
function mmRow(r, i) {
  const sel = G.sel === i && !r.done;
  const a = (r.blank === 'node' && r.anchor === 'B') ? mmNode(r.A, { blank: true, sel, done: r.done, idx: i }) : mmNode(r.A, {});
  const b = (r.blank === 'node' && r.anchor === 'A') ? mmNode(r.B, { blank: true, sel, done: r.done, idx: i }) : mmNode(r.B, {});
  const re = r.blank === 'reagent'
    ? (r.done ? `<span class="pill filled">${esc(r.R)}</span>` : `<button class="pill blank ${sel ? 'sel' : ''}" data-act="mmsel" data-row="${i}" aria-label="Missing reagent">reagents & conditions ?</button>`)
    : `<span class="pill">${esc(r.R)}</span>`;
  return `<div class="mmrow ${r.done ? 'ok' : ''} ${G.flash === i ? 'flash' : ''}">${a}<span class="arr" aria-hidden="true">▶</span>${b}<div class="mr">${re}</div></div>`;
}
function renderMM() {
  const L = LESSONS[G.id], done = G.rows.filter(r => r.done).length, pct = Math.round(done / G.rows.length * 100);
  const strip = G.msg ? `<div class="mmstrip ${G.msg.ok === true ? 'ok' : G.msg.ok === false ? 'bad' : ''}">${G.msg.html}</div>` : '<div class="mmstrip"></div>';
  const chips = G.chips.filter(c => !c.used).map(c => `<button class="chip ${c.type} ${G.shake === c.id ? 'shake' : ''}" data-act="mmchip" data-chip="${c.id}">${esc(c.text)}</button>`).join('');
  const html = `<div class="mm"><div class="mmtop">
      <div class="ptop"><button class="x" data-act="quit" aria-label="Leave challenge">✕</button><div class="spectrum" role="progressbar" aria-valuenow="${pct}"><div class="cover" style="width:${100 - pct}%"></div></div>${liveHTML()}</div>
      <h2 class="mmtitle disp">${L.icon} ${esc(L.title)}</h2>
      <div class="mmhelp">Reconstruct organic steps. Tap a ? slot, then choose the correct option below.</div>${strip}</div>
    <div class="mmrows">${G.rows.map(mmRow).join('')}</div>
    <div class="chipbar"><div class="t">Reagent & Compound Bank (${G.chips.filter(c => !c.used && !c.id.startsWith('d')).length} required)</div><div class="chips">${chips}</div></div></div>`;
  G.shake = null; G.flash = null;
  $('#app').innerHTML = html;
}
function mmPlace(chipId) {
  const ch = G.chips.find(c => c.id === chipId); if (!ch || ch.used) return;
  let r = G.rows[G.sel]; if (!r || r.done) { G.sel = G.rows.findIndex(x => !x.done); r = G.rows[G.sel]; }
  if (ch.type !== r.blank) { G.msg = { ok: null, html: r.blank === 'reagent' ? 'Selected slot requires a reagent/condition.' : 'Selected slot requires an organic product.' }; G.shake = ch.id; return renderMM(); }
  const t = (performance.now() - G.t0) / 1000; G.t0 = performance.now(); G.answered++;
  if (ch.text === G.ans(r)) {
    G.correct++; G.streak++; G.bestStreak = Math.max(G.bestStreak, G.streak);
    const sc = calcPoints(t, TIME_LIMIT_MM, G.streak, G.correct, G.answered); G.score += sc.pts;
    r.done = true; ch.used = true;
    G.msg = { ok: true, html: `+${sc.pts} &nbsp; ⚡${sc.speed} × 🔥${sc.streak} × 🎯${sc.acc.toFixed(2)}` };
    G.sel = G.rows.findIndex(x => !x.done);
    if (G.sel === -1) { G.sel = 0; renderMM(); return setTimeout(finishRun, 700); }
  } else {
    G.streak = 0; G.shake = ch.id; G.flash = G.sel; G.msg = { ok: false, html: 'Incorrect step! Streak reset.' };
  }
  renderMM();
}

/* ---- finish and results ---- */
async function finishRun() {
  const acc = G.answered ? G.correct / G.answered : 0, stars = acc >= .9 ? 3 : acc >= .7 ? 2 : 1;
  const prev = S.user.progress[G.id] || { best: 0, plays: 0 };
  const isBest = G.score > (prev.best || 0);
  S.user.progress[G.id] = { best: Math.max(prev.best || 0, G.score), stars: Math.max(prev.stars || 0, stars), bestStreak: Math.max(prev.bestStreak || 0, G.bestStreak), done: true, plays: (prev.plays || 0) + 1 };
  const L = LESSONS[G.id]; S.subject = L.subject; S.sem[L.subject] = L.sem; S.tab = 'learn';
  S.result = { id: G.id, score: G.score, acc, streak: G.bestStreak, time: Math.round((Date.now() - G.started) / 1000), stars, isBest, first: !prev.plays, rank: null };
  G = null; S.screen = 'result'; render();
  await saveUser(); await pushScore(); await loadBoard();
  if (S.screen === 'result' && S.result) { S.result.rank = rankOf('total'); render(); }
}
function resultHTML() {
  const R = S.result, L = LESSONS[R.id];
  const head = R.stars === 3 ? 'A* Performance!' : R.stars === 2 ? 'Great Revision!' : 'Topic Completed';
  return `<div class="result"><div class="st" aria-label="${R.stars} of 3 stars">${'★'.repeat(R.stars)}${'☆'.repeat(3 - R.stars)}</div>
    <h2>${head}</h2><div class="lab">${esc(L.title)}</div>
    <div class="big">${R.score}</div><div class="lab">points earned</div>
    ${R.isBest && !R.first ? '<span class="badge">New Personal Best</span>' : ''}
    <div class="stats"><div class="stat"><b>${Math.round(R.acc * 100)}%</b><span>Accuracy</span></div><div class="stat"><b>${R.streak}</b><span>Best streak</span></div><div class="stat"><b>${R.time}s</b><span>Time</span></div></div>
    ${R.rank ? `<p class="sub" style="margin-bottom:16px">Rank #${R.rank} on the global leaderboard!</p>` : ''}
    <div class="row"><button class="btn ghost" data-act="again" data-id="${R.id}">Replay</button><button class="btn" data-act="home">Continue</button></div></div>`;
}
function confirmQuit() {
  const d = document.createElement('div'); d.className = 'confirm'; d.id = 'confirm';
  d.innerHTML = `<div class="box"><h3>Leave session?</h3><p>Your current score won't be saved.</p><div class="row"><button class="btn ghost" data-act="stay">Keep going</button><button class="btn bad" data-act="leave">Quit</button></div></div>`;
  document.body.appendChild(d);
}

/* ---------------------------------------------------------------------
   6. QUESTION BANK
   --------------------------------------------------------------------- */
function unitOptions(sel) {
  return ['chem', 'bio'].map(sk => CUR[sk].sems.map((s, si) => `<optgroup label="${CUR[sk].name} - ${s.title}">${s.units.map(u => `<option value="${u[0]}" ${sel === u[0] ? 'selected' : ''}>${esc(u[1])}</option>`).join('')}</optgroup>`).join('')).join('');
}
function bankHTML() {
  const tabs = [['add', 'Add Question'], ['bulk', 'CSV Upload'], ['browse', 'Browse All']];
  const t = S.bankTab;
  let body = '';
  if (t === 'add') body = `<div class="card"><label class="f" for="f-unit" style="margin-top:0">Cambridge Topic Unit</label><select id="f-unit">${unitOptions(S.bankUnit)}</select>
      <label class="f" for="f-q">Exam Question</label><textarea id="f-q" maxlength="300" placeholder="Type an A-Level style question stem..."></textarea>
      <label class="f" for="f-fig">Diagram/Figure <small>(optional, max 1MB)</small></label><input id="f-fig" type="file" accept="image/png,image/jpeg,image/webp" style="width:100%">
      <label class="f" for="f-alt">Figure Description</label><input id="f-alt" type="text" maxlength="200" placeholder="e.g. Mass spectrum of compound X showing peak at m/z 58">
      <label class="f">Option Choices <small>(Mark correct answer)</small></label>
      ${[0, 1, 2, 3].map(i => `<div class="optrow"><input type="radio" name="correct" value="${i}" ${i === 0 ? 'checked' : ''}><input type="text" id="f-o${i}" maxlength="120" placeholder="Option ${'ABCD'[i]}"></div>`).join('')}
      <label class="f" for="f-exp">Mark Scheme Explanation</label><textarea id="f-exp" maxlength="300" style="min-height:64px" placeholder="Explain the key chemistry/biology principle..."></textarea>
      <div style="margin-top:14px"><button class="btn" data-act="submitQ">Submit to Question Bank</button></div></div>`;
  else if (t === 'bulk') {
    const b = S.bulk;
    body = `<div class="card"><label class="f" for="b-unit" style="margin-top:0">Target Syllabus Unit</label><select id="b-unit">${unitOptions(S.bankUnit)}</select>
      <label class="f" for="bulkfile">Upload CSV or JSON file</label><input id="bulkfile" type="file" accept=".csv,.json,text/csv,application/json" style="width:100%">
      ${b ? `<div style="margin-top:12px"><b>${esc(b.name)}</b>: ${b.valid.length} valid questions ready.</div>${b.valid.length ? `<div style="margin-top:10px"><button class="btn" data-act="uploadBulk">Import ${b.valid.length} questions</button></div>` : ''}` : ''}</div>
      <div class="card"><h3>CSV Layout</h3><p class="sub">Header: question, A, B, C, D, answer, explanation</p>
      <div style="margin:10px 0"><button class="btn small ghost" data-act="template">Download Template CSV</button></div></div>`;
  } else {
    const list = S.community.filter(c => S.browseUnit === 'all' || c.unit === S.browseUnit).slice().reverse().slice(0, 100);
    body = `<label class="f" for="br-unit" style="margin-top:0">Filter by Topic Unit</label><select id="br-unit"><option value="all">All Syllabus Topics (${S.community.length})</option>${unitOptions(S.browseUnit)}</select><div style="height:12px"></div>
      ${list.length ? list.map(c => `<div class="card q-item"><div class="meta">${esc(LESSONS[c.unit].title)} · by ${esc(String(c.by || 'a student').slice(0, 20))}</div><div class="qq">${esc(String(c.q).slice(0, 300))}</div><ul>${c.opts.map((o, i) => `<li class="${i === c.c ? 'c' : ''}">${esc(String(o).slice(0, 120))}</li>`).join('')}</ul>${c.pid === S.user.pid ? `<div style="margin-top:10px"><button class="btn small ghost" data-act="delq" data-id="${esc(c.id)}">Delete</button></div>` : ''}</div>`).join('') : '<div class="empty">No community questions submitted yet for this topic.</div>'}`;
  }
  return `<h2 class="pg">Question Bank</h2><p class="sub">Custom Cambridge 9700/9701 practice questions.</p>
    <div class="pills">${tabs.map(x => `<button class="${t === x[0] ? 'on' : ''}" data-act="bankTab" data-t="${x[0]}">${x[1]}</button>`).join('')}</div>${body}`;
}
function validateQ({ q, opts, exp }) {
  if (q.length < 10) return 'Question stem must be at least 10 characters.';
  if (!Array.isArray(opts) || opts.length !== 4) return 'Exactly 4 options required.';
  if (opts.some(o => !o)) return 'Complete all 4 options.';
  return '';
}
const norm = s => String(s).toLowerCase().replace(/\s+/g, ' ').trim();
function makeRec(unit, q, opts, c, exp, img, alt) {
  const r = { id: Date.now().toString(36) + Math.random().toString(36).slice(2, 7), unit, q, opts, c, exp: exp || '', by: S.user.name, pid: S.user.pid, ts: Date.now() };
  if (img) { r.img = img; r.alt = alt; }
  return r;
}
const isDupe = (unit, q) => S.community.some(c => c.unit === unit && norm(c.q) === norm(q)) || (QUESTIONS[unit] || []).some(x => norm(x[0]) === norm(q));
async function saveRecs(recs) {
  let ok = 0;
  for (let i = 0; i < recs.length; i += 10) {
    const res = await Promise.all(recs.slice(i, i + 10).map(r => DB.set('cq:' + r.id, r, true)));
    res.forEach((v, j) => { if (v) { S.community.push(recs[i + j]); ok++; } });
  }
  return ok;
}
async function submitQ() {
  const unit = $('#f-unit').value, q = $('#f-q').value.trim(), opts = [0, 1, 2, 3].map(i => $('#f-o' + i).value.trim());
  const c = +((document.querySelector('input[name=correct]:checked') || { value: 0 }).value), exp = $('#f-exp').value.trim();
  const err = validateQ({ q, opts, exp }); if (err) return toast(err, 'bad');
  if (isDupe(unit, q)) return toast('Question already exists.', 'bad');
  S.bankUnit = unit;
  const file = $('#f-fig').files[0], alt = $('#f-alt').value.trim().slice(0, 200);
  let img = '';
  if (file) { try { img = await uploadFigure(file); } catch (e) { return toast(e.message, 'bad'); } }
  const n = await saveRecs([makeRec(unit, q, opts, c, exp, img, alt)]);
  if (n) { toast('Question added to bank!', 'ok'); render(); } else toast('Error saving question.', 'bad');
}
function parseCSV(text) {
  const rows = []; let row = [], cell = '', quoted = false;
  for (let i = 0; i < text.length; i++) {
    const c = text[i];
    if (quoted) { if (c === '"') { if (text[i + 1] === '"') { cell += '"'; i++; } else quoted = false; } else cell += c; }
    else if (c === '"') quoted = true;
    else if (c === ',') { row.push(cell); cell = ''; }
    else if (c === '\n' || c === '\r') { if (c === '\r' && text[i + 1] === '\n') i++; row.push(cell); cell = ''; if (row.some(x => x.trim() !== '')) rows.push(row); row = []; }
    else cell += c;
  }
  row.push(cell); if (row.some(x => x.trim() !== '')) rows.push(row);
  return rows;
}
function toIndex(a, opts) {
  const s = String(a ?? '').trim();
  if (/^[A-D]$/i.test(s)) return s.toUpperCase().charCodeAt(0) - 65;
  return opts.findIndex(o => o.toLowerCase() === s.toLowerCase());
}
async function handleFile(file) {
  if (!file) return;
  const text = (await file.text()).replace(/^\uFEFF/, ''); let rows = [];
  try {
    const t = parseCSV(text); if (t.length && /question/i.test(t[0][0])) t.shift();
    rows = t.map(r => ({ q: r[0], opts: [r[1], r[2], r[3], r[4]], ans: r[5], exp: r[6] || '' }));
  } catch (e) { return toast('File format error.', 'bad'); }
  const valid = [];
  rows.slice(0, 100).forEach((r, i) => {
    const q = String(r.q ?? '').trim(), exp = String(r.exp ?? '').trim(), opts = (Array.isArray(r.opts) ? r.opts : []).map(x => String(x ?? '').trim());
    const err = validateQ({ q, opts, exp }), c = err ? -1 : toIndex(r.ans, opts);
    if (!err && c >= 0) valid.push({ q, opts, c, exp });
  });
  S.bulk = { name: file.name, valid }; render();
}
async function uploadBulk() {
  if (!S.bulk) return;
  const unit = S.bankUnit, recs = [];
  for (const v of S.bulk.valid) { if (!isDupe(unit, v.q)) recs.push(makeRec(unit, v.q, v.opts, v.c, v.exp)); }
  const n = await saveRecs(recs); S.bulk = null;
  toast(`${n} questions imported!`, 'ok'); render();
}
function downloadTemplate() {
  const csv = 'question,A,B,C,D,answer,explanation\n"Which organelle synthesises ATP?","Mitochondrion","Ribosome","Golgi body","Nucleus","A","Mitochondria carry out oxidative phosphorylation."\n';
  const a = document.createElement('a'); a.href = URL.createObjectURL(new Blob([csv], { type: 'text/csv' })); a.download = 'bondly-alevel-template.csv';
  document.body.appendChild(a); a.click(); a.remove();
}

/* ---------------------------------------------------------------------
   7. EVENTS AND INIT
   --------------------------------------------------------------------- */
async function enterApp(name) {
  const uid = Auth.s.user.id, email = Auth.s.user.email;
  let u = await DB.get('user:' + uid, false);
  if (!u) {
    if (!name || name.length < 2) { S.login.step = 'name'; render(); return; }
    u = { id: uid, email, name, pid: uid, progress: {}, created: Date.now() };
  } else { if (name && name.length >= 2) u.name = name; u.pid = uid; u.email = email; }
  S.user = u; await saveUser();
  await Promise.all([loadBoard(), loadCommunity()]); await pushScore();
  S.screen = 'main'; S.tab = 'learn'; render();
}
async function onlineLogin() {
  const L = S.login, err = m => { const e = $('#loginErr'); if (e) e.textContent = m; }, btn = $('#loginBtn');
  try {
    err('');
    if (L.step === 'email') {
      const email = $('#email').value.trim().toLowerCase(), name = $('#name').value.trim().slice(0, 20);
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(email)) return err('Valid email required.');
      await Auth.sendCode(email); L.email = email; L.name = name; L.step = 'code'; render();
    } else if (L.step === 'code') {
      const code = $('#code').value.replace(/\s/g, '');
      await Auth.verify(L.email, code); await enterApp(L.name);
    } else {
      const name = $('#name').value.trim().slice(0, 20);
      await enterApp(name);
    }
  } catch (e) { err(friendly(e)); }
}
async function doLogin() {
  if (ONLINE) return onlineLogin();
  const email = $('#email').value.trim().toLowerCase(), name = $('#name').value.trim().slice(0, 20);
  const id = idOf(email); let u = await DB.get('user:' + id, false);
  if (!u) u = { id, email, name: name || 'A-Level Student', pid: await hashId(email), progress: {}, created: Date.now() };
  S.user = u; await saveUser(); await DB.set('session', { id }, false);
  await Promise.all([loadBoard(), loadCommunity()]); await pushScore();
  S.screen = 'main'; S.tab = 'learn'; render();
}

const ACT = {
  login: doLogin,
  tab: el => { S.tab = el.dataset.tab; S.sheet = null; render(); if (S.tab === 'board') refreshBoard(); },
  subject: el => { S.subject = el.dataset.s; render(); },
  sem: el => { S.sem[S.subject] = +el.dataset.i; render(); },
  open: el => {
    const id = el.dataset.id, L = LESSONS[id], sec = sections(L.subject, L.sem).find(s => s.ids.includes(id)), i = sec.ids.indexOf(id);
    if (!unlocked(sec, i)) return toast('Complete the preceding topic first!', 'bad');
    S.sheet = id; render();
  },
  overlay: (el, e) => { if (e.target === el) { S.sheet = null; render(); } },
  closeSheet: () => { S.sheet = null; render(); },
  start: el => { const id = el.dataset.id; LESSONS[id].kind === 'mm' ? startMM(id) : startMCQ(id); },
  again: el => { const id = el.dataset.id; S.result = null; LESSONS[id].kind === 'mm' ? startMM(id) : startMCQ(id); },
  home: () => { S.result = null; S.screen = 'main'; S.tab = 'learn'; render(); },
  pick: el => pick(+el.dataset.i),
  next: nextQ,
  quit: confirmQuit,
  stay: () => { const c = $('#confirm'); if (c) c.remove(); },
  leave: () => { const c = $('#confirm'); if (c) c.remove(); G = null; S.screen = 'main'; render(); },
  mmsel: el => { const i = +el.dataset.row; if (G && G.rows[i] && !G.rows[i].done) { G.sel = i; G.msg = null; renderMM(); } },
  mmchip: el => mmPlace(el.dataset.chip),
  boardFilter: el => { S.boardFilter = el.dataset.f; render(); },
  refreshBoard: () => refreshBoard(true),
  bankTab: el => { S.bankTab = el.dataset.t; S.bulk = null; render(); },
  submitQ, uploadBulk, template: downloadTemplate,
  delq: async el => {
    const id = el.dataset.id;
    await DB.del('cq:' + id, true); S.community = S.community.filter(c => c.id !== id); toast('Question deleted.', 'ok'); render();
  },
  resend: async () => { try { await Auth.sendCode(S.login.email); toast('Code sent!', 'ok'); } catch (e) { toast(friendly(e), 'bad'); } },
  changeEmail: () => { S.login.step = 'email'; render(); },
  pickAvatar: () => { const f = $('#avfile'); if (f) f.click(); },
  removeAvatar: clearAvatar,
  signout: async () => {
    if (DB.mode === 'online') await Auth.signOut(); else await DB.del('session', false);
    S.user = null; S.screen = 'login'; S.sheet = null; render();
  }
};
async function refreshBoard(show) {
  await loadBoard();
  if (S.screen === 'main' && S.tab === 'board') { render(); if (show) toast('Leaderboard updated.', 'ok'); }
}

document.addEventListener('click', e => { const el = e.target.closest('[data-act]'); if (el && ACT[el.dataset.act]) ACT[el.dataset.act](el, e); });
document.addEventListener('change', e => {
  const t = e.target;
  if (t.id === 'bulkfile') handleFile(t.files[0]);
  else if (t.id === 'avfile') { setAvatar(t.files[0]); t.value = ''; }
  else if (t.id === 'f-unit' || t.id === 'b-unit') S.bankUnit = t.value;
  else if (t.id === 'br-unit') { S.browseUnit = t.value; render(); }
});
document.addEventListener('keydown', e => {
  if (e.target.matches('input,textarea,select')) { if (e.key === 'Enter' && S.screen === 'login' && e.target.matches('input')) doLogin(); return; }
  if (S.screen !== 'play' || !G) return;
  const k = e.key.toLowerCase();
  if (!G.locked) { const i = '1234'.indexOf(k) >= 0 ? '1234'.indexOf(k) : 'abcd'.indexOf(k); if (k.length === 1 && i >= 0) pick(i); }
  else if (e.key === 'Enter') { e.preventDefault(); nextQ(); }
});

(async function init() {
  render();
  DB.init();
  await loadExternalQuestions();
  try {
    if (DB.mode === 'online') {
      if (Auth.s && await Auth.fresh()) {
        const u = await DB.get('user:' + Auth.s.user.id, false);
        if (u) { u.pid = Auth.s.user.id; S.user = u; await Promise.all([loadBoard(), loadCommunity()]); S.screen = 'main'; }
      }
    } else {
      const sess = await DB.get('session', false);
      if (sess && sess.id) {
        const u = await DB.get('user:' + sess.id, false);
        if (u) { if (!u.pid) u.pid = await hashId(u.email); S.user = u; await Promise.all([loadBoard(), loadCommunity()]); S.screen = 'main'; }
      }
    }
  } catch (e) { S.screen = 'login'; S.user = null; }
  S.ready = true; render();
})();
