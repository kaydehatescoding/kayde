async function loadExternalQuestions() {
  if (!/^https?:$/.test(location.protocol)) return;
  try {
    const r = await fetch('questions.json', { cache: 'no-cache' }); if (!r.ok) return;
    const d = await r.json();
    for (const [unit, list] of Object.entries(d)) {
      if (!LESSONS[unit] || LESSONS[unit].kind !== 'mcq' || !Array.isArray(list)) continue;
      const out = [];
      for (const q of list) {
        if (Array.isArray(q) && q.length >= 5 && q.slice(0, 5).every(x => typeof x === 'string' && x.trim())) out.push([q[0], q[1], q[2], q[3], q[4], q[5] || '', q[6] || '', q[7] || '']);
        else if (q && typeof q === 'object' && q.question) {
          const o = ['a', 'b', 'c', 'd'].map(k => q['option_' + k]), ci = 'ABCD'.indexOf(String(q.answer).trim().toUpperCase());
          if (o.every(x => typeof x === 'string' && x.trim()) && ci >= 0) out.push([q.question, o[ci], ...o.filter((_, i) => i !== ci), q.explanation || '', typeof q.image === 'string' ? q.image : '', q.alt || '']);
        }
      }
      if (out.length) QUESTIONS[unit] = out;
    }
  } catch (e) {}
}
