  pack(d) { return { access_token: d.access_token, refresh_token: d.refresh_token, expires_at: d.expires_at || (Math.floor(Date.now() / 1000) + (d.expires_in || 3600)), user: { id: d.user.id, email: d.user.email } }; },
  async sendCode(email) { await sb('/auth/v1/otp', { method: 'POST', noAuth: true, body: { email, create_user: true } }); },
  async verify(email, token) { const d = await sb('/auth/v1/verify', { method: 'POST', noAuth: true, body: { type: 'email', email, token } }); this.save(this.pack(d)); return this.s; },
  async fresh() {
    if (!this.s) return false;
